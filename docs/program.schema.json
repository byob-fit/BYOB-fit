{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byob-fit/BYOB-fit/program.schema.json",
  "title": "BYOB-fit program file",
  "description": "Frozen at Gate 2, Sep 13, 2026; wording re-frozen Sep 14, 2026; version 2 frozen Sep 27, 2026 (PLAN v1.5 section 5, D-035); byWeek overrides closed Sep 28, 2026 (D-038); optional item field progression added Sep 28, 2026 (D-047). A program is a 7-day template with per-week overrides. Sessions, profile, goals, meals and settings are separate stores and are not part of this file. Version 1 files import unchanged and are stored as version 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "weekStartsOn",
    "programWeeks",
    "startDate",
    "exercises",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "description": "1 = Gate 2 format; 2 adds exercise metadata and item retirement (D-035). Import accepts both and stores 2."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Free text, e.g. v11"
    },
    "weekStartsOn": {
      "const": "sunday"
    },
    "programWeeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "The Sunday that begins program week 1; import is rejected if this date is not a Sunday. currentWeek is derived: floor((today - startDate) / 7 days) + 1, clamped to 1..programWeeks."
    },
    "notes": {
      "type": "string"
    },
    "exercises": {
      "type": "object",
      "description": "Keyed by exercise id",
      "additionalProperties": {
        "$ref": "#/$defs/exercise"
      }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "howTo"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "howTo": {
          "type": "string",
          "description": "One to three sentences shown under 'How to perform'"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "muscles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chest",
              "back",
              "shoulders",
              "arms",
              "legs",
              "glutes",
              "core",
              "full_body",
              "cardio"
            ]
          },
          "description": "Primary muscle groups; drives the swap picker's Same muscles filter"
        },
        "equipment": {
          "enum": [
            "none",
            "barbell",
            "dumbbell",
            "kettlebell",
            "cable",
            "machine",
            "band",
            "bench",
            "cardio_machine",
            "other"
          ],
          "description": "Main equipment; none = bodyweight (the swap picker's No equipment filter)"
        },
        "level": {
          "enum": [
            "beginner",
            "intermediate",
            "experienced"
          ],
          "description": "Lowest level the exercise suits; drives the Beginner friendly filter"
        },
        "demo": {
          "type": "string",
          "pattern": "^demos/[a-z0-9-]+\\.(webp|mp4|webm)$",
          "description": "Path of a demo bundled with the app under public/demos/; never an external URL (D-033)"
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "name",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "0 = Sunday"
        },
        "name": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "durationMin": {
          "type": "integer",
          "minimum": 0
        },
        "swappableWith": {
          "type": "string",
          "description": "Day id this day may swap with in a given week"
        },
        "rest": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "warmup",
            "main",
            "block",
            "abs",
            "cardio",
            "cooldown",
            "daily"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "itemFields": {
      "type": "object",
      "properties": {
        "exerciseId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "load_reps",
            "bodyweight_reps",
            "timed_hold",
            "distance",
            "cardio_block",
            "check"
          ]
        },
        "perSide": {
          "type": "boolean"
        },
        "sets": {
          "type": "integer",
          "minimum": 1
        },
        "repMin": {
          "type": "integer",
          "minimum": 1
        },
        "repMax": {
          "type": "integer",
          "minimum": 1
        },
        "holdSec": {
          "type": "integer",
          "minimum": 1
        },
        "distanceM": {
          "type": "integer",
          "minimum": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "tempo": {
          "type": "string",
          "description": "e.g. 3-1-1"
        },
        "restSec": {
          "type": "integer",
          "minimum": 0
        },
        "rpe": {
          "type": "string",
          "description": "e.g. 8 or 7 to 8"
        },
        "unit": {
          "enum": [
            "kg",
            "lb"
          ],
          "description": "Load unit for load_reps items; shown as entered, no conversion"
        },
        "index": {
          "type": "boolean",
          "description": "Index lift: monitored between scans, surfaced in Log, subject to the >5% rule"
        },
        "logged": {
          "type": "boolean",
          "description": "Overrides the section default: main/block/abs log per set, cardio logs minutes, warmup/cooldown/daily are check-off"
        },
        "cue": {
          "type": "string",
          "description": "Short coaching cue shown on the tile in muted text"
        },
        "notes": {
          "type": "string"
        },
        "alternateExerciseId": {
          "type": "string",
          "description": "One-tap substitute; the session records which was done"
        }
      }
    },
    "item": {
      "allOf": [
        {
          "$ref": "#/$defs/itemFields"
        },
        {
          "type": "object",
          "required": [
            "id",
            "exerciseId",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "byWeek": {
              "type": "object",
              "description": "Keys are program week numbers as strings. Overrides are cumulative: for week W, apply every override whose key is <= W in ascending key order on top of the base item, later keys overwriting earlier ones field by field. Any itemFields property may be overridden, including exerciseId for staged progressions. Only itemFields properties are allowed inside an override; any other key, including retiredFrom, is rejected (corrected Sep 28, 2026, D-038).",
              "propertyNames": {
                "pattern": "^[0-9]{1,2}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/itemFields",
                "unevaluatedProperties": false
              }
            },
            "retiredFrom": {
              "type": "string",
              "format": "date",
              "description": "Retired, not deleted (D-028): the item does not appear on days dated on or after this date; its logged history stays in the Log. An item with history is never removed from the file."
            },
            "progression": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Consecutive sessions at the top of the rep range before a weight suggestion"
                },
                "percent": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10,
                  "description": "Load increase in percent"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Smallest load change, in the item's unit"
                }
              },
              "description": "Replaces the default progression rule for this item (D-047). Not allowed inside byWeek."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
