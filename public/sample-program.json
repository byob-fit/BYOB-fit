{
  "schemaVersion": 1,
  "id": "sample-3day",
  "name": "Sample three-day program",
  "version": "sample",
  "weekStartsOn": "sunday",
  "programWeeks": 8,
  "startDate": "2026-09-06",
  "notes": "Generic sample so anyone can try the app. Replace it with your own program via Settings, Import program.",
  "exercises": {
    "walk": {
      "name": "Walk",
      "howTo": "Easy pace, upright posture, relaxed arms.",
      "tags": [
        "warmup"
      ]
    },
    "band-pull-apart": {
      "name": "Band pull-apart",
      "howTo": "Arms straight at shoulder height, pull the band apart to the chest, squeeze the shoulder blades.",
      "tags": [
        "warmup"
      ]
    },
    "ramp": {
      "name": "Ramp sets",
      "howTo": "Light sets building to the working weight with the same technique as the working sets.",
      "tags": [
        "warmup"
      ]
    },
    "back-squat": {
      "name": "Back squat",
      "howTo": "Bar on the upper back, brace, sit down under control to full depth, drive up with knees tracking over toes.",
      "tags": [
        "legs"
      ]
    },
    "leg-press": {
      "name": "Leg press",
      "howTo": "Feet mid-platform, lower until the knees pass 90 degrees without the lower back lifting, press through mid-foot.",
      "tags": [
        "legs"
      ]
    },
    "hamstring-curl": {
      "name": "Hamstring curl",
      "howTo": "Curl fully, pause, lower over 2 seconds.",
      "tags": [
        "hamstrings"
      ]
    },
    "standing-calf-raise": {
      "name": "Standing calf raise",
      "howTo": "Rise fully onto the toes, lower over 3 seconds to a full stretch.",
      "tags": [
        "calves"
      ]
    },
    "bench-press": {
      "name": "Barbell bench press",
      "howTo": "Shoulder blades pinned, bar to the lower chest with elbows about 45 degrees, pause, press.",
      "tags": [
        "chest"
      ]
    },
    "incline-db-press": {
      "name": "Incline dumbbell press",
      "howTo": "Bench at 30 degrees, press the dumbbells up and slightly together, lower under control.",
      "tags": [
        "chest"
      ]
    },
    "seated-db-ohp": {
      "name": "Seated dumbbell overhead press",
      "howTo": "Back supported, press the dumbbells overhead, lower to ear height.",
      "tags": [
        "shoulders"
      ]
    },
    "lateral-raise": {
      "name": "Lateral raise",
      "howTo": "Raise the dumbbells to shoulder height with a soft elbow, lower over 2 seconds.",
      "tags": [
        "shoulders"
      ]
    },
    "rope-pushdown": {
      "name": "Rope pushdown",
      "howTo": "Elbows pinned to the sides, push the rope down and apart, control the return.",
      "tags": [
        "triceps"
      ]
    },
    "pull-up": {
      "name": "Pull-up",
      "howTo": "Full hang, pull the chest to the bar, lower to a full hang each rep.",
      "tags": [
        "back"
      ]
    },
    "chest-supported-row": {
      "name": "Chest-supported row",
      "howTo": "Chest on the pad, row to the ribs, squeeze the shoulder blades, lower slowly.",
      "tags": [
        "back"
      ]
    },
    "face-pull": {
      "name": "Face pull",
      "howTo": "Rope at face height, pull toward the face with elbows high, rotate the hands back at the end.",
      "tags": [
        "rear-delts"
      ]
    },
    "db-curl": {
      "name": "Dumbbell curl",
      "howTo": "Elbows at the sides, curl to full contraction, lower over 2 seconds.",
      "tags": [
        "biceps"
      ]
    },
    "plank": {
      "name": "Plank",
      "howTo": "Forearms and toes, body in one line, glutes squeezed, breathe.",
      "tags": [
        "abs"
      ]
    },
    "dead-bug": {
      "name": "Dead bug",
      "howTo": "On your back, lower the opposite arm and leg with the lower back pressed down, return, alternate.",
      "tags": [
        "abs"
      ]
    },
    "farmer-carry": {
      "name": "Farmer carry",
      "howTo": "Heavy dumbbells at the sides, walk tall with short quick steps.",
      "tags": [
        "grip"
      ]
    },
    "incline-walk": {
      "name": "Incline walk",
      "howTo": "Treadmill at 6 to 8%, hands off the rails, nose-breathing pace.",
      "tags": [
        "cardio"
      ]
    },
    "couch-stretch": {
      "name": "Couch stretch",
      "howTo": "Rear knee against a wall, front foot forward, tuck the pelvis, stay tall, hold.",
      "tags": [
        "mobility"
      ]
    },
    "doorway-pec-stretch": {
      "name": "Doorway pec stretch",
      "howTo": "Forearm on the door frame, step through until the chest stretches, hold.",
      "tags": [
        "mobility"
      ]
    },
    "single-leg-stance": {
      "name": "Single-leg stance",
      "howTo": "Stand on one foot for the hold; close the eyes once steady.",
      "tags": [
        "balance"
      ]
    },
    "steps": {
      "name": "Steps 8,000+",
      "howTo": "Check the day's step count before bed.",
      "tags": [
        "daily"
      ]
    }
  },
